<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="0"
      prefWidth="560" prefHeight="520"
      style="-fx-background-color: #F5F6FA;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.connexion3a36.Controller.HistoriqueVersionController">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="14"
          style="-fx-background-color: #1A1A2E; -fx-padding: 20 24;">
        <Label text="🕘" style="-fx-font-size: 28px;"/>
        <VBox spacing="2">
            <Label text="Historique des versions"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label fx:id="subtitleLabel" text="..."
                   style="-fx-font-size: 12px; -fx-text-fill: #9e9e9e;"/>
        </VBox>
    </HBox>

    <!-- Hidden title used by controller -->
    <Label fx:id="titleLabel" visible="false" managed="false"/>

    <!-- Scrollable version list -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-border-color: transparent;">
        <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
        <VBox fx:id="versionsContainer" spacing="12"/>
    </ScrollPane>

    <!-- Footer -->
    <HBox alignment="CENTER_RIGHT"
          style="-fx-padding: 12 16; -fx-background-color: white;
                 -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
        <Button text="Fermer" onAction="#handleClose"
                style="-fx-background-color: #E0E0E0; -fx-text-fill: #333;
                       -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 8 20;"/>
    </HBox>
</VBox>