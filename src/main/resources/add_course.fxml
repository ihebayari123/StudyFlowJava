<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.connexion3a36.Controller.AddCourseController"
      spacing="0"
      style="-fx-background-color: white;">

    <!-- ══ HEADER ══════════════════════════════════════════════════════════ -->
    <HBox style="-fx-background-color: #1A1A2E; -fx-padding: 18 24;">
        <Label fx:id="formTitle" text="Ajouter un Cours"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: white; -fx-border-color: transparent;">
    <VBox spacing="0">

    <!-- ══ AI DESCRIPTION GENERATOR ════════════════════════════════════════ -->
    <VBox spacing="12"
          style="-fx-background-color: #EEF2FF; -fx-padding: 16 24;
                 -fx-border-color: transparent transparent #C7D2FE transparent; -fx-border-width: 0 0 1 0;">

        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="✨" style="-fx-font-size: 16px;"/>
            <Label text="Générateur IA de description"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3730A3;"/>
        </HBox>

        <Label text="Saisissez d'abord le titre du cours ci-dessous, puis cliquez sur Générer."
               style="-fx-font-size: 11px; -fx-text-fill: #6366F1;" wrapText="true"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Public cible (optionnel)"
                       style="-fx-font-size: 11px; -fx-text-fill: #6366F1;"/>
                <TextField fx:id="aiAudienceField"
                           promptText="ex : Débutants avec bases en Python"
                           style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #C7D2FE; -fx-padding: 7 10;"/>
            </VBox>
            <VBox spacing="4" alignment="BOTTOM_LEFT">
                <Label text=" " style="-fx-font-size: 11px;"/>
                <Button fx:id="aiGenerateBtn"
                        text="✨ Générer avec l'IA"
                        onAction="#handleGenerateDescription"
                        style="-fx-background-color: #4F46E5; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-padding: 8 16;
                               -fx-cursor: hand; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </VBox>
        </HBox>

        <Label fx:id="aiStatusLabel" text=""
               style="-fx-font-size: 11px; -fx-text-fill: #6366F1;" wrapText="true"/>
    </VBox>

    <!-- ══ FORM FIELDS ═════════════════════════════════════════════════════ -->
    <VBox spacing="16" style="-fx-padding: 20 24;">

        <!-- Titre -->
        <VBox spacing="4">
            <Label text="Titre *" style="-fx-font-weight: bold; -fx-text-fill: #333; -fx-font-size: 12px;"/>
            <TextField fx:id="titreField"
                       promptText="Entrez le titre du cours (3-100 caractères)"
                       style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 8 12;"/>
            <Label fx:id="titreErrorLabel"
                   style="-fx-text-fill: red; -fx-font-size: 11px;" visible="false"/>
        </VBox>

        <!-- Description -->
        <VBox spacing="4">
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label text="Description *"
                       style="-fx-font-weight: bold; -fx-text-fill: #333; -fx-font-size: 12px;"/>
                <Label text="(générée automatiquement par l'IA ou saisie manuelle)"
                       style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
            </HBox>
            <TextArea fx:id="descriptionField"
                      promptText="Entrez la description du cours (10-500 caractères)"
                      prefHeight="110" wrapText="true"
                      style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 8 12;"/>
            <Label fx:id="descriptionErrorLabel"
                   style="-fx-text-fill: red; -fx-font-size: 11px;" visible="false"/>
        </VBox>

        <!-- AI Objectives (shown after generation) -->
        <VBox spacing="4">
            <Label text="Objectifs d'apprentissage (générés par l'IA)"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #3730A3;"/>
            <TextArea fx:id="aiObjectivesArea"
                      promptText="Les objectifs d'apprentissage apparaîtront ici après génération..."
                      prefHeight="90" wrapText="true" editable="true"
                      style="-fx-background-radius: 6; -fx-border-radius: 6;
                             -fx-border-color: #C7D2FE; -fx-padding: 8 12;
                             -fx-background-color: #F5F3FF;"/>
        </VBox>

        <!-- Image URL -->
        <VBox spacing="4">
            <Label text="Image URL" style="-fx-font-weight: bold; -fx-text-fill: #333; -fx-font-size: 12px;"/>
            <HBox spacing="10">
                <TextField fx:id="imageField"
                           promptText="URL de l'image (jpg, png, gif, webp)"
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 8 12;"/>
                <Button text="Parcourir..." onAction="#handleBrowseImage"
                        style="-fx-background-color: #E0E0E0; -fx-text-fill: #333;
                               -fx-cursor: hand; -fx-background-radius: 6; -fx-padding: 8 12;"/>
            </HBox>
            <Label fx:id="imageErrorLabel"
                   style="-fx-text-fill: orange; -fx-font-size: 11px;" visible="false"/>
        </VBox>

        <!-- Image Preview -->
        <HBox spacing="10">
            <StackPane prefWidth="100" prefHeight="100"
                       style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7;
                              -fx-border-radius: 8; -fx-background-radius: 8;">
                <ImageView fx:id="imagePreview" fitWidth="90" fitHeight="90" preserveRatio="true"/>
            </StackPane>
        </HBox>

    </VBox>

    <!-- ══ BUTTONS ══════════════════════════════════════════════════════════ -->
    <Separator/>
    <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 14 24;">
        <Button text="Annuler" onAction="#handleCancel"
                style="-fx-background-color: #E0E0E0; -fx-text-fill: #333;
                       -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 10 20;"/>
        <Button fx:id="saveButton" text="💾  Enregistrer" onAction="#handleSave"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 10 20;"/>
    </HBox>

    </VBox>
    </ScrollPane>
</VBox>
